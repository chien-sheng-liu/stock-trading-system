## Copy this file to `.env` and fill in real values.
## The backend reads these via python-dotenv; `.env` is git-ignored.

## Backend + Airflow unified .env example
## Copy this file to `backend/.env` and fill real values.

# ---------- Database (PostgreSQL) ----------
# Used by backend (core.settings) and can also be injected into Airflow via env_file
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stocks
DB_USER=your_user
DB_PASS=your_password

# Optional: single URL form if your infra prefers it
# DATABASE_URL=postgresql://your_user:your_password@postgres:5432/stocks

# ---------- Redis (optional, for realtime bars cache) ----------
# Disable by default. Set REDIS_ENABLED=true only if you have a Redis bar feed.
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
REDIS_BARS_KEY_PATTERN=bars:{ticker}:{interval}

# ---------- FinMind provider ----------
FINMIND_API_BASE=https://api.finmindtrade.com
FINMIND_API_TOKEN=your_finmind_token

# ---------- OpenAI (backend AI features) ----------
OPENAI_API_KEY=sk-...
# Chat models auto-detected: gpt-4o, gpt-4o-mini；instruct: gpt-3.5-turbo-instruct
OPENAI_MODEL=gpt-4o-mini

# ---------- Airflow: connections and variables via environment ----------
# Airflow reads connections from env AIRFLOW_CONN_<CONN_ID>
AIRFLOW_CONN_PG_STOCKS=postgresql+psycopg2://your_user:your_password@postgres:5432/stocks
# If you later add a Redis publish task in the DAG
AIRFLOW_CONN_REDIS_MARKET=redis://:your_password@redis:6379/0

# Airflow Variables: AIRFLOW_VAR_<KEY>
AIRFLOW_VAR_INTERVAL=1m
AIRFLOW_VAR_WINDOW_MIN=5
AIRFLOW_VAR_MAX_TICKERS_PER_RUN=50

# Override DAG Postgres connection id if not using default
AIRFLOW_PG_CONN_ID=pg_stocks

# ---------- Frontend (optional CORS) ----------
FRONTEND_URL=http://localhost:3000
